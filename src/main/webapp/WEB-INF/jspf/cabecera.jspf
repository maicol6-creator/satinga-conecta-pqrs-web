<%-- Fragmento incluido con la DIRECTIVA include (se une a la página en tiempo de traducción).
     Dibuja el menú lateral si hay sesión o la barra pública si no la hay. --%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="ruta" value="${requestScope['jakarta.servlet.forward.servlet_path']}"/>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${titulo}"/> · Satinga Conecta</title>
  <link rel="stylesheet" href="<c:url value='/css/estilos.css'/>">
</head>
<body>
<a class="skip" href="#main">Saltar al contenido</a>
<c:choose>
<c:when test="${not empty usuarioActual}">
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-logo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.3 11l7.4-3.8M8.3 13l7.4 3.8"/></symbol>
  <symbol id="i-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></symbol>
  <symbol id="i-msg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></symbol>
  <symbol id="i-doc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8"/></symbol>
  <symbol id="i-heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"/></symbol>
  <symbol id="i-brief" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2M2 13h20"/></symbol>
  <symbol id="i-alert" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01"/></symbol>
  <symbol id="i-map" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></symbol>
  <symbol id="i-chart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18M7 15v3M12 9v9M17 12v6"/></symbol>
  <symbol id="i-poll" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 17v-5M12 17V8M16 17v-3"/></symbol>
  <symbol id="i-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></symbol>
  <symbol id="i-bell" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/></symbol>
</svg>
<div class="app">
<nav class="side" aria-label="Menú principal">
  <a class="brand" href="<c:url value='/inicio'/>"><span class="logo"><svg aria-hidden="true" focusable="false"><use href="#i-logo"/></svg></span>Satinga Conecta</a>
  <button class="side-toggle" type="button" aria-expanded="false" aria-controls="sideLinks">☰ Menú</button>
  <div class="side-links" id="sideLinks">
    <span class="sep">Servicios</span>
    <a href="<c:url value='/inicio'/>" class="${ruta == '/inicio' ? 'cur' : ''}"><svg aria-hidden="true" focusable="false"><use href="#i-home"/></svg>Mi panel</a>
    <a href="<c:url value='/pqrs'/>" class="${ruta == '/pqrs' || ruta == '/pqrs/detalle' ? 'cur' : ''}"><svg aria-hidden="true" focusable="false"><use href="#i-msg"/></svg>${usuarioActual.funcionario ? 'Todas las PQRS' : 'Mis PQRS'}</a>
    <c:if test="${not usuarioActual.funcionario}">
      <a href="<c:url value='/pqrs/nueva'/>" class="${ruta == '/pqrs/nueva' ? 'cur' : ''}"><svg aria-hidden="true" focusable="false"><use href="#i-doc"/></svg>Radicar PQRS</a>
    </c:if>
    <a href="<c:url value='/consulta'/>" class="${ruta == '/consulta' ? 'cur' : ''}"><svg aria-hidden="true" focusable="false"><use href="#i-map"/></svg>Consultar radicado</a>
    <span class="sep">Cuenta</span>
    <form method="post" action="<c:url value='/salir'/>">
      <input type="hidden" name="csrf" value="<c:out value='${csrf}'/>">
      <button class="side-out" type="submit"><svg aria-hidden="true" focusable="false"><use href="#i-out"/></svg>Cerrar sesión</button>
    </form>
  </div>
</nav>
<div class="main">
<div class="top">
  <div class="crumb"><a href="<c:url value='/inicio'/>">Inicio</a> / <b><c:out value="${titulo}"/></b></div>
  <div class="user"><div class="avatar" aria-hidden="true">${fn:toUpperCase(fn:substring(usuarioActual.nombre, 0, 1))}</div><b><c:out value="${usuarioActual.nombre}"/></b></div>
</div>
<main class="content" id="main">
</c:when>
<c:otherwise>
<header class="pub-head">
  <a class="brand" href="<c:url value='/login'/>"><span class="logo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.3 11l7.4-3.8M8.3 13l7.4 3.8"/></svg></span>Satinga Conecta</a>
  <nav class="pub-nav" aria-label="Principal" style="display:flex">
    <a href="<c:url value='/consulta'/>">Consultar radicado</a>
    <a href="<c:url value='/registro'/>">Registrarse</a>
    <a class="btn sm" href="<c:url value='/login'/>">Iniciar sesión</a>
  </nav>
</header>
<main id="main" class="${layout == 'auth' ? '' : 'content pub'}">
</c:otherwise>
</c:choose>
<c:if test="${not empty flash and layout != 'auth'}">
  <div class="aviso ${flashTipo == 'error' ? 'error' : 'ok'}" role="status"><c:out value="${flash}"/></div>
</c:if>
